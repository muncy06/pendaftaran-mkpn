<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pembayaran UKT</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            hijaukeren: "#006635",
            hitamkeren: "#231f20"
          }
        }
      }
    }
  </script>
</head>
<body class="bg-gray-100 min-h-screen font-sans">

  <!-- Header -->
  <header class="bg-hitamkeren text-white p-4 flex items-center">
    <img src="logo pn.png" alt="Logo" class="h-10 mr-4">
    <h1 class="text-xl font-semibold">Halaman Pembayaran UKT</h1>
  </header>

  <!-- Konten -->
  <main class="flex justify-center p-6">
    <div class="bg-white p-8 rounded-2xl shadow-md w-full max-w-2xl space-y-6">

      <!-- Rekap Data -->
      <div>
        <h2 class="text-hitamkeren font-semibold text-lg mb-2">Data Pendaftar</h2>
        <p><strong>Nama:</strong> <span id="nama">-</span></p>
        <p><strong>Email:</strong> <span id="email">-</span></p>
      </div>

      <!-- Pilihan Pembayaran -->
      <div>
        <label class="block text-hitamkeren font-semibold">Opsi Pembayaran</label>
        <select id="opsiPembayaran" onchange="toggleQRIS()"
                class="mt-1 w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-hijaukeren">
          <option disabled selected>Pilih Opsi</option>
          <option value="transfer">Transfer (QRIS/VA)</option>
          <option value="cash">Cash di Tempat</option>
        </select>
      </div>

      <!-- QRIS & VA -->
      <div id="qrisSection" class="hidden transition-all duration-300">
        <label class="block text-hitamkeren font-semibold mb-2">Pembayaran via Transfer</label>
        <div class="bg-gray-50 border border-gray-300 p-4 rounded-lg text-center">
          <p class="text-gray-700 mb-2">Scan QRIS di bawah atau gunakan Virtual Account:</p>
          <img src="qris-placeholder.png" alt="QRIS" class="w-40 h-40 mx-auto mb-2">
          <p class="text-sm text-gray-600">VA: 1234 5678 9012<br>a.n. UKM Pencak Silat UNUSIA</p>
        </div>
      </div>

      <!-- Tombol Bayar -->
      <div class="text-center">
        <button onclick="selesaikanPembayaran()"
                class="bg-hijaukeren text-white px-6 py-3 rounded-lg hover:bg-green-800 transition duration-300 shadow-md">
          Selesaikan Pembayaran
        </button>
      </div>
    </div>
  </main>

  <script>
    // Ambil parameter dari URL
    const params = new URLSearchParams(window.location.search);
    document.getElementById("nama").textContent = params.get("nama") || "-";
    document.getElementById("email").textContent = params.get("email") || "-";

    // Tampilkan QRIS jika memilih Transfer
    function toggleQRIS() {
      const pilihan = document.getElementById("opsiPembayaran").value;
      const qris = document.getElementById("qrisSection");
      qris.classList.toggle("hidden", pilihan !== "transfer");
    }

    function selesaikanPembayaran() {
      alert("Terima kasih! Silakan lanjutkan proses pembayaran.");
      // Nanti bisa diarahkan ke backend tripay/midtrans di sini
    }
  </script>

</body>
</html>
